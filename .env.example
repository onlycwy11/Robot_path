# MQTT 配置示例
# 复制此文件为 .env 并填写实际账号密码

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=your_username
MQTT_PASSWORD=your_password
MQTT_CLIENT_ID=robot_scheduler_client

# MQTT Topic 配置
# 机器人状态消息 Topic 格式: {topicPrefix}/robot/{robotId}/status_agg
MQTT_TOPIC_PREFIX=pro
MQTT_STATUS_TOPIC=pro/robot/+/status_agg

# 是否启用 MQTT（开发时可设为 false 使用模拟数据）
MQTT_ENABLED=true

# 消息超时时间（秒）
MQTT_MESSAGE_TIMEOUT=30